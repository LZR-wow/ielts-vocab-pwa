借出的"},{"word":"category","ipa":"kˈætʌɡˌɔri","meaning":"种类"},{"word":"closed reserve","ipa":"klˈoʊzd rɪzˈɝv","meaning":"只读不借的区域"},{"word":"circulation","ipa":"sˈɝkjʌlˌeɪʃʌn","meaning":"循环"},{"word":"classification","ipa":"klˌæsʌfʌkˈeɪʃʌn","meaning":"分类"},{"word":"bibliography","ipa":"bˌɪbliˈɑɡrʌfi","meaning":"参考书目"},{"word":"periodical","ipa":"pˌɪriˈɑdɪkʌl","meaning":"期刊"},{"word":"reserve","ipa":"rɪzˈɝv","meaning":"预借"},{"word":"interlibrary service","ipa":"sˈɝvʌs","meaning":"图书馆际服务"},{"word":"open shelves","ipa":"ˈoʊpʌn ʃˈelvz","meaning":"开架书库"},{"word":"close shelves","ipa":"klˈoʊs ʃˈelvz","meaning":"闭架书库"},{"word":"check out","ipa":"tʃˈek ˈaʊt","meaning":"登记并借出"},{"word":"delivery desk","ipa":"dɪlˈɪvɝi dˈesk","meaning":"借书台"},{"word":"internet system","ipa":"ˈɪntɝnˌet sˈɪstʌm","meaning":"互联网系统"},{"word":"recall","ipa":"rˈikˌɔl","meaning":"回忆；要求归还某物"},{"word":"pink","ipa":"pˈɪŋk","meaning":"粉色"},{"word":"slip","ipa":"slˈɪp","meaning":"一张纸"},{"word":"stack","ipa":"stˈæk","meaning":"书库"},{"word":"circle","ipa":"sˈɝkʌl","meaning":"圆"},{"word":"copy","ipa":"kˈɑpi","meaning":"复印"},{"word":"card index","ipa":"kˈɑrd ˈɪndeks","meaning":"卡片索引"}];const KEY="ielts_vocab_workbench_v1";let S=JSON.parse(localStorage.getItem(KEY)||"null")||{cursor:0,mastered:{}};
function toggleMastered(i, checked){
  if(checked){
    S.mastered[i] = 1;
  }else{
    delete S.mastered[i];
  }
  save();
  render();
}

function save(){localStorage.setItem(KEY,JSON.stringify(S))}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function norm(s){return s.toLowerCase().trim().replace(/[’‘]/g,"'").replace(/\s+/g," ")}
function render(reset){
 const n=Math.max(1,Math.min(DATA.length,+document.getElementById("daily").value||200)),mode=document.getElementById("mode").value;
 const arr=DATA.map((x,i)=>({...x,i})).filter(()=>true);const start=arr.length?S.cursor%arr.length:0;const show=[];
 for(let k=0;k<n&&k<arr.length;k++)show.push(arr[(start+k)%arr.length]);
 document.getElementById("total").textContent=DATA.length;document.getElementById("shown").textContent=show.length;document.getElementById("mastered").textContent=Object.keys(S.mastered).length;document.getElementById("pos").textContent=(S.cursor%DATA.length+1)+" / "+DATA.length;document.getElementById("bar").style.width=(Object.keys(S.mastered).length/DATA.length*100)+"%";
 const box=document.getElementById("cards");box.innerHTML="";
 if(!show.length){box.innerHTML='<div class="panel empty">暂无词汇可显示。</div>';return}
 show.forEach(x=>{const c=document.createElement("article");c.className="card"+(S.mastered[x.i]?" mastered":"");c.innerHTML='<div class="word">'+esc(x.word)+'</div><div class="ipa">'+esc(x.ipa)+'</div><div class="meaning">'+esc(x.meaning)+'</div><div class="exercise"><input data-spell="'+x.i+'" placeholder="输入英文拼写，按 Enter 检查" autocomplete="off"></div><div class="feedback" id="f'+x.i+'"></div><div class="actions"><label class="familiar"><input type="checkbox" data-master="'+x.i+'" '+(S.mastered[x.i]?"checked":"")+'> 非常熟悉，以后不再练</label><button class="soft" data-speak="'+esc(x.word)+'">🔊 发音</button></div>';box.appendChild(c)});
 box.querySelectorAll("[data-spell]").forEach(inp=>inp.addEventListener("keydown",e=>{if(e.key!=="Enter")return;const i=+inp.dataset.spell,fb=document.getElementById("f"+i);if(norm(inp.value)===norm(DATA[i].word)){fb.textContent="✓ 拼写正确";fb.className="feedback correct";inp.style.borderColor="#58b488"}else{fb.textContent="✕ 拼写错误，请再试一次";fb.className="feedback wrong";inp.style.borderColor="#db6969"}}));
 box.querySelectorAll("[data-master]").forEach(ch=>ch.addEventListener("change",e=>{const i=+e.target.dataset.master;if(e.target.checked)S.mastered[i]=1;else delete S.mastered[i];save();render(true)}));
 box.querySelectorAll("[data-speak]").forEach(b=>b.addEventListener("click",()=>{if(!("speechSynthesis" in window))return;speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(b.dataset.speak);u.lang="en-GB";speechSynthesis.speak(u)}));
 if(!reset){S.cursor=(S.cursor+show.length)%DATA.length;save()}
}
function resetProgress(){if(confirm("确定清除全部熟悉标记和学习位置吗？")){S={cursor:0,mastered:{}};save();render(true)}}
render(true);

function escapeHtml(v){
  return String(v ?? '').replace(/[&<>"']/g, ch => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[ch]));
}
function escapeAttr(v){
  return escapeHtml(v);
}

