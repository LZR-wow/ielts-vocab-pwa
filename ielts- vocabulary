<style>
:root{--pink:#F8D9E6;--blue:#DCEEFF;--mint:#DDF5E7;--yellow:#FFF1C9;--lav:#E9E0FF;--text:#404255;--muted:#85889a}
*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif;color:var(--text);background:linear-gradient(135deg,#fff7fb,#f7fbff,#f9fff9)}
.wrap{max-width:1120px;margin:auto;padding:22px 18px 50px}header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
h1{margin:0;font-size:28px}.sub{color:var(--muted);font-size:14px;margin-top:5px}.panel{background:#ffffffdf;border:1px solid #eeeaf1;border-radius:24px;padding:18px;margin-top:18px;box-shadow:0 10px 30px #4a3c5a12}
.controls{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:12px;align-items:end}label{font-size:13px;color:var(--muted);display:block;margin-bottom:7px}
select,input{width:100%;border:1px solid #e4e2e9;border-radius:14px;padding:11px 12px;background:#fff;color:var(--text);font:inherit}
button{border:0;border-radius:14px;padding:11px 15px;font-weight:700;cursor:pointer}.primary{background:var(--pink)}.soft{background:var(--blue)}
.stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:15px}.stat{background:#faf8fc;padding:10px 13px;border-radius:14px;font-size:13px}
.progress{height:10px;background:#eeeaf1;border-radius:99px;overflow:hidden;margin:15px 0 20px}.bar{height:100%;background:linear-gradient(90deg,#f6c5d9,#cce7ff,#ccefdc)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}.card{border-radius:22px;padding:18px;min-height:215px;border:1px solid #00000008}
.card:nth-child(5n+1){background:var(--pink)}.card:nth-child(5n+2){background:var(--blue)}.card:nth-child(5n+3){background:var(--mint)}.card:nth-child(5n+4){background:var(--yellow)}.card:nth-child(5n){background:var(--lav)}.card.mastered{background:#fff!important;opacity:.88}
.word{font-size:24px;font-weight:800}.ipa{font-size:14px;color:#66697b;margin-top:5px}.meaning{margin-top:9px;font-size:15px;line-height:1.55}.exercise{margin-top:14px}
.feedback{min-height:24px;margin-top:6px;font-weight:700;font-size:13px}.correct{color:#168451}.wrong{color:#d44747}
.actions{display:flex;justify-content:space-between;align-items:center;margin-top:10px;gap:8px}.familiar{display:flex;align-items:center;gap:6px}.familiar input{width:18px;height:18px;accent-color:#61b78e}
.empty{text-align:center;padding:45px;color:var(--muted)}@media(max-width:760px){.controls{grid-template-columns:1fr 1fr}.controls>div:last-child{grid-column:1/-1}h1{font-size:24px}}

/* Mobile App UX */
html{background:#f7f9fc}
body{min-height:100vh;-webkit-tap-highlight-color:transparent;overscroll-behavior-y:none}
button,input,select{touch-action:manipulation}
.wrap{padding:max(18px,env(safe-area-inset-top)) 14px max(32px,env(safe-area-inset-bottom));}
header{position:sticky;top:0;z-index:20;padding:8px 0 12px;background:linear-gradient(180deg,#f9fbff 78%,transparent)}
.panel{backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.card{min-height:0;padding:17px;border-radius:20px;box-shadow:0 5px 18px rgba(60,70,90,.06)}
.word{font-size:27px}
.exercise input{font-size:16px;min-height:48px}
select,input{min-height:46px;font-size:16px}
button{min-height:46px}
.actions{flex-wrap:wrap}
.familiar{font-size:14px}
.familiar input{min-height:20px}
@media(max-width:760px){
  .wrap{padding-left:12px;padding-right:12px}
  h1{font-size:22px}
  .sub{font-size:12px}
  header .soft{padding:9px 11px;font-size:12px;min-height:40px}
  .panel{border-radius:20px;padding:14px;margin-top:10px}
  .controls{grid-template-columns:1fr 1fr;gap:9px}
  .controls>div:last-child{grid-column:1/-1}
  .controls button{width:100%}
  .stats{gap:7px;margin-top:12px}
  .stat{flex:1 1 calc(50% - 7px);padding:9px 10px}
  .grid{grid-template-columns:1fr;gap:10px}
  .card{border-radius:18px}
  .meaning{font-size:14px}
  .actions{align-items:center}
  .actions .soft{margin-left:auto}
}
@media(min-width:761px){
  .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
</style>
